# =============================================================================
# OPROX Academy — Required Environment Variables
# Copy this file to .env and fill in real values before starting the server.
# The server will throw a FATAL error at startup if required vars are missing.
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (REQUIRED)
# -----------------------------------------------------------------------------

# JWT_SECRET: Secret used to sign and verify JWT session tokens.
# MUST be set to a cryptographically random string of at least 64 bytes.
# The compromised key 'oprox-os-phase1-secure-jwt-key-2026' must NOT be used.
# Generate a new secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="<generate-a-secure-random-64-byte-hex-string>"

# SESSION_SECRET: Secret for session cookie signing (Express session).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="<generate-a-secure-random-32-byte-hex-string>"

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------

# DATABASE_URL: PostgreSQL connection string.
# The server will not start without a real database connection.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/oprox_academy"

# -----------------------------------------------------------------------------
# Stripe Payments (REQUIRED for billing features)
# -----------------------------------------------------------------------------

# STRIPE_PUBLISHABLE_KEY: Your Stripe publishable key (starts with pk_live_ or pk_test_).
# Obtain from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# STRIPE_SECRET_KEY: Your Stripe secret key (starts with sk_live_ or sk_test_).
# NEVER commit this value. Keep it in secrets only.
STRIPE_SECRET_KEY="sk_live_..."

# STRIPE_WEBHOOK_SECRET: Webhook signing secret from your Stripe dashboard endpoint.
# Obtain from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# -----------------------------------------------------------------------------
# AI Providers (REQUIRED for AI features)
# -----------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Google Gemini AI API calls.
GEMINI_API_KEY="<your-gemini-api-key>"

# OPENAI_API_KEY: Required for OpenAI GPT API calls.
OPENAI_API_KEY="<your-openai-api-key>"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# APP_URL: The URL where this service is hosted (used for OAuth callbacks, links).
APP_URL="https://your-domain.com"

# NODE_ENV: Set to "production" in production deployments.
NODE_ENV="development"

# PORT: HTTP port the server listens on. Defaults to 3000 if not set.
PORT=3000

# -----------------------------------------------------------------------------
# Redis (optional, recommended for production)
# -----------------------------------------------------------------------------

# REDIS_URL: Redis connection string for JWT token blacklisting (cross-instance
# logout invalidation). When not set, token invalidation falls back to in-process
# memory which is single-instance only.
# Example: redis://user:password@host:6379
REDIS_URL=

# Alternatively, specify host and port separately:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Security — CORS origin
# -----------------------------------------------------------------------------

# ALLOWED_ORIGIN / APP_URL: Restrict CORS to a specific origin in production.
# If APP_URL is set to a specific domain, CORS uses it. Defaults to '*' (open)
# for development. Always set this to your real domain in production.
ALLOWED_ORIGIN=

# JWT Secret Rotation — Task #5
# After rotating JWT_SECRET, set this to the Unix timestamp (seconds) of the rotation.
# All tokens issued before this timestamp will be rejected, invalidating any
# tokens signed with the old (potentially leaked) secret.
# Generate the value: date +%s
# JWT_ISSUED_AFTER=
